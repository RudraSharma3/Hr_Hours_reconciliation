# ===========================================================================
# Employee Hours Reconciliation Automation — Environment Variables
# ===========================================================================

# ---------------------------------------------------------------------------
# 1. Database Connection
# ---------------------------------------------------------------------------
# PostgreSQL connection string for production (Neon, Supabase, RDS) or local dev.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ---------------------------------------------------------------------------
# 2. Application Base Configuration
# ---------------------------------------------------------------------------
# Base URL used for email links, callback URLs, and webhook redirects.
APP_BASE_URL="http://localhost:3000"

# Lifespan of confirmation magic links in days before expiring (default: 14).
CONFIRMATION_TOKEN_TTL_DAYS=14

# ---------------------------------------------------------------------------
# 3. Authentication & Security
# ---------------------------------------------------------------------------
# Secret used to sign admin session JWT cookies. Generate with: openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-string-at-least-48-chars"

# Secret required in the Authorization header of any /api/cron/* call.
# Generate with: openssl rand -hex 32
CRON_SECRET="replace-with-a-long-random-string-32-chars"

# ---------------------------------------------------------------------------
# 4. Messaging Channel Configuration
# ---------------------------------------------------------------------------
# Options:
#   - google_chat (default): Native Google Chat Cards v2 Bot / Workspace Add-on.
#   - email: Magic confirmation links sent via SMTP / Mock email.
MESSAGING_CHANNEL=google_chat

# ---------------------------------------------------------------------------
# 5. Google Chat Bot Configuration (when MESSAGING_CHANNEL=google_chat)
# ---------------------------------------------------------------------------
# Full HTTPS interactive endpoint URL for Google Workspace Add-on card actions.
# Example: https://hr-hours-reconciliation.vercel.app/api/chat/google
GOOGLE_CHAT_HTTP_ENDPOINT=

# Optional verification token configured in Google Cloud Console > Google Chat API
# (verified on inbound requests to /api/chat/google).
GOOGLE_CHAT_VERIFICATION_TOKEN=

# Google Cloud Service Account JSON credentials for proactive 1:1 DMs via Chat API.
# Single line JSON string.
GOOGLE_CHAT_SERVICE_ACCOUNT_KEY=

# Default space ID fallback if DM resolution is not available.
GOOGLE_CHAT_DEFAULT_SPACE_ID=

# Incoming Webhook URL for posting messages directly to a specific Google Chat space.
GOOGLE_CHAT_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# 6. Email Configuration (when MESSAGING_CHANNEL=email)
# ---------------------------------------------------------------------------
# EMAIL_MODE:
#   - mock (default): prints email payload to console and logs to database.
#   - smtp: sends live email via configured SMTP server.
EMAIL_MODE=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="HR Reconciliation <hr@example.com>"

# ---------------------------------------------------------------------------
# 7. ERP / Timesheet Integration
# ---------------------------------------------------------------------------
# ERP_MODE:
#   - csv (default): manual CSV timesheet upload via the ERP Import page.
#   - erpnext: automatic REST API pull from ERPNext timesheets.
ERP_MODE=csv

# Required when ERP_MODE=erpnext or when using the ERPNext webhook endpoint.
ERPNEXT_BASE_URL=
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=

# Optional: Comma-separated patterns/keywords to ignore when aggregating ERP timesheets.
# Defaults to: learning phase, learning and development, l&d, leave, leaves, holiday, holidays, wfh, work from home
ERP_EXCLUDED_PATTERNS="learning phase,learning and development,l&d,leave,holiday,wfh,work from home"

# Secret configured in ERPNext Webhook settings (signed with X-Frappe-Webhook-Signature).
ERPNEXT_WEBHOOK_SECRET=
