# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local dev / demo uses SQLite (a file on disk). For production, point this at
# a Postgres connection string instead and change the `provider` in
# prisma/schema.prisma from "sqlite" to "postgresql" (see README).
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Secret used to sign admin session JWTs. Generate a real one for production:
#   openssl rand -base64 48
JWT_SECRET="replace-this-with-a-long-random-string"

# Secret required in the header of any /api/cron/* call, so scheduled jobs
# can't be triggered by an outsider hitting the URL.
#   openssl rand -hex 32
CRON_SECRET="replace-this-with-a-long-random-string"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Base URL used to build the secure confirmation links sent to employees.
APP_BASE_URL="http://localhost:3000"

# Days a confirmation link stays valid before it expires.
CONFIRMATION_TOKEN_TTL_DAYS=14

# ---------------------------------------------------------------------------
# ERP integration
# ---------------------------------------------------------------------------
# ERP_MODE=csv       -> manual CSV upload via the ERP Import page (default).
# ERP_MODE=erpnext   -> pulls directly from ERPNext's REST API. The CSV
#                       import page still works either way as a manual
#                       fallback. See README "Connecting ERPNext".
ERP_MODE=csv

# Required when ERP_MODE=erpnext, and always required for the ERPNext
# webhook route (src/app/api/erp/webhook/erpnext) regardless of ERP_MODE,
# since that route calls the same adapter.
ERPNEXT_BASE_URL=
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=

# Shared secret configured on the ERPNext side (Settings > Webhook > Enable
# Security > Webhook Secret) when Doctype=Timesheet, Doc Event=on_submit,
# Request URL=<APP_BASE_URL>/api/erp/webhook/erpnext. ERPNext signs each
# request with this via the X-Frappe-Webhook-Signature header; our route
# verifies it. Generate with: openssl rand -hex 32
ERPNEXT_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Messaging (Email adapter)
# ---------------------------------------------------------------------------
# EMAIL_MODE=mock   -> no real email is sent; messages are logged to the
#                      database (MessageLog) and printed to the server console.
#                      This is the default and requires no credentials.
# EMAIL_MODE=smtp   -> real email is sent via the SMTP settings below.
EMAIL_MODE=mock

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="HR Reconciliation <hr@example.com>"

# ---------------------------------------------------------------------------
# Messaging channel selection
# ---------------------------------------------------------------------------
# MESSAGING_CHANNEL=email        -> EmailAdapter (default, see above).
# MESSAGING_CHANNEL=google_chat  -> GoogleChatAdapter (Native Google Chat Cards v2 Bot).
# MESSAGING_CHANNEL=evolra       -> EvolraChatAdapter (Evolra proxy adapter).
MESSAGING_CHANNEL=email

# ---------------------------------------------------------------------------
# Google Chat Bot (when MESSAGING_CHANNEL=google_chat)
# ---------------------------------------------------------------------------
# If unset, GoogleChatAdapter runs in local MOCK mode (prints full Card v2 JSON
# payloads to console and saves to MessageLog).
#
# Option A: Space Webhook URL
# GOOGLE_CHAT_WEBHOOK_URL="https://chat.googleapis.com/v1/spaces/.../messages?key=..."
#
# Option B: Google Cloud Service Account JSON credentials for 1:1 DMs via Chat API
# GOOGLE_CHAT_SERVICE_ACCOUNT_KEY='{"type":"service_account",...}'
# GOOGLE_CHAT_DEFAULT_SPACE_ID="spaces/..."
#
# Verification token configured in Google Cloud Console > Google Chat API
# (verified on inbound requests to /api/chat/google).
GOOGLE_CHAT_VERIFICATION_TOKEN=

# ---------------------------------------------------------------------------
# Evolra (in-house Google Chat bot proxy)
# ---------------------------------------------------------------------------
# Required when MESSAGING_CHANNEL=evolra. If unset, EvolraChatAdapter runs
# in a mock mode (prints to console) same as EMAIL_MODE=mock.
EVOLRA_API_BASE_URL=
EVOLRA_API_KEY=

# Shared secret Evolra must send back on its webhook call to us
# (/api/webhooks/evolra) as `Authorization: Bearer <this value>`.
# Generate with: openssl rand -hex 32
EVOLRA_WEBHOOK_SECRET=


# ---------------------------------------------------------------------------
# Future integrations (not yet implemented — see README "Extending Adapters")
# ---------------------------------------------------------------------------
# TEAMS_WEBHOOK_URL=
# SLACK_BOT_TOKEN=
# WHATSAPP_BUSINESS_API_TOKEN=

